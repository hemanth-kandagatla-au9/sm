            "properties": {
              "timestamp": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Display string, e.g. '11th Feb, 26  21:12 pm'"
              },
              "processing_time": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "e.g. '30 sec'"
              },
              "tokens": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "cost": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Pre-formatted, e.g. '$0.0023'"
              }
