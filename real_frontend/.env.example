# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local development.  .env.local is git-ignored.
#
# Rule: a variable prefixed NEXT_PUBLIC_ is compiled into the JavaScript bundle
# and is readable by anyone with the page open. Backend hosts are NOT public,
# so they carry no prefix and are read only in server code.
# ─────────────────────────────────────────────────────────────────────────────

# The AG-UI event stream. Where agui_server.py is reachable FROM THE NEXT SERVER.
AGUI_BACKEND_URL=http://localhost:8084/copilotkit

# The deterministic REST lookups (platforms, target systems, templates, Jira).
# Same host, different surface. Also server-side only.
AGUI_API_BASE=http://localhost:8084

# Where the browser sends agent traffic. Same-origin by design: the browser
# never learns the backend host.
NEXT_PUBLIC_AGENT_PATH=/api/agent

# Must match LangGraphAGUIAgent(name=...) in agui_server.py.
NEXT_PUBLIC_AGUI_AGENT_NAME=local_agent
