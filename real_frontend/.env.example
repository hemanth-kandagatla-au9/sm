# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local development.  .env.local is git-ignored.
#
# Rule: a variable prefixed NEXT_PUBLIC_ is compiled into the JavaScript bundle
# and is readable by anyone with the page open. Nothing secret carries it.
# ─────────────────────────────────────────────────────────────────────────────

# ── The agent runtime: AWS Bedrock AgentCore ─────────────────────────────────
# The combined runtime + endpoint ARN. The region and the qualifier are parsed
# out of this one value, so there is no second variable to disagree with it.
AGENTCORE_RUNTIME_ENDPOINT_ARN=arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/your-runtime/runtime-endpoint/DEFAULT

# ── Azure AD, for the bearer token the runtime's JWT authorizer expects ──────
# Server-side only. AZURE_CLIENT_SECRET is a real secret: never give it a
# NEXT_PUBLIC_ prefix, and never commit a filled-in value.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
# Optional. Defaults to api://<AZURE_CLIENT_ID>/.default
# AZURE_TOKEN_SCOPE=

# ── The browser ──────────────────────────────────────────────────────────────
# Where the browser posts. Same-origin by design: it never learns the runtime
# ARN, the region, or anything about the identity provider.
NEXT_PUBLIC_AGENT_PATH=/api/agent

# For local development with NO AWS or Azure configuration at all, point this at
# the scripted backend instead and restart `npm run dev`:
# NEXT_PUBLIC_AGENT_PATH=/api/agent/mock?scenario=flow

# Must match the agent's registered name in the runtime.
NEXT_PUBLIC_AGUI_AGENT_NAME=local_agent

# ── Build identity, reported by /api/health. Set by the pipeline. ────────────
# APP_VERSION=
# GIT_SHA=

# ── Contract refresh only ────────────────────────────────────────────────────
# `npm run contract:pull` fetches /api/ui-contract from a running agui_server.py.
# This is a developer script, not used by the running app.
# AGUI_API_BASE=http://localhost:8084
